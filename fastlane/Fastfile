# Fastfile - es省電王（CameraPPP）TestFlight 自動部署
# 用 App Store Connect API 金鑰在雲端完成簽章，不需要 Mac 上的 Xcode 帳號或鑰匙圈。
require "base64"

default_platform(:ios)

def asc_api_key
  key_id = ENV.fetch("APP_STORE_CONNECT_KEY_ID").strip
  issuer_id = ENV.fetch("APP_STORE_CONNECT_ISSUER_ID").strip
  raw_key = ENV.fetch("APP_STORE_CONNECT_KEY").strip
  key_text = raw_key.include?("BEGIN PRIVATE KEY") ? raw_key : Base64.decode64(raw_key)
  body = key_text.gsub(/-----(BEGIN|END) PRIVATE KEY-----/, "").gsub(/[^A-Za-z0-9+\/=]/, "")
  key_content = "-----BEGIN PRIVATE KEY-----\n#{body.scan(/.{1,64}/).join("\n")}\n-----END PRIVATE KEY-----\n"
  app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, key_content: key_content, in_house: false)
end


platform :ios do


  desc "準備上架資料（說明、截圖、選建置、自動發布）；submit:true 會直接送審"
  lane :prepare_release do |options|
    asc_api_key
    version = get_version_number(xcodeproj: "CameraPPP.xcodeproj", target: "CameraPPP")
    build = latest_testflight_build_number(app_identifier: "com.lin.energysaving", version: version)
    UI.message("使用建置 #{version} (#{build})")
    submit = options[:submit].to_s == "true" || ENV["SUBMIT_FOR_REVIEW"] == "true"
    deliver(
      app_identifier: "com.lin.energysaving",
      app_version: version,
      build_number: build.to_s,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: submit,
      automatic_release: true,
      force: true,
      run_precheck_before_submit: false,
      submission_information: { add_id_info_uses_idfa: false, export_compliance_uses_encryption: false },
      metadata_path: File.expand_path("metadata", __dir__),
      screenshots_path: File.expand_path("appstore_screenshots", __dir__)
    )
    UI.success(submit ? "已送審 #{version} (#{build})，審核通過會自動上架" : "已準備好 #{version} (#{build})，尚未送審")
  end

  desc "查看 App Store 上目前的版本、語系與建置（只讀）"
  lane :inspect_store do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find("com.lin.energysaving")
    UI.message("App: #{app.name} primary_locale=#{app.primary_locale}")
    app.get_app_store_versions.each do |v|
      UI.message("Version #{v.version_string} state=#{v.app_store_state} release=#{v.release_type}")
      v.get_app_store_version_localizations.each do |l|
        UI.message("  loc #{l.locale} keywords=#{l.keywords.inspect} support=#{l.support_url} marketing=#{l.marketing_url}")
        UI.message("  desc=#{l.description.to_s[0,300].inspect}")
      end
    end
    builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 3)
    builds.each { |b| UI.message("Build #{b.app_version} (#{b.version}) state=#{b.processing_state}") }
  end
  desc "建置並上傳至 TestFlight（只限內部測試，不會送審）"
  lane :beta do
    key_id = ENV.fetch("APP_STORE_CONNECT_KEY_ID").strip
    issuer_id = ENV.fetch("APP_STORE_CONNECT_ISSUER_ID").strip
    raw_key = ENV.fetch("APP_STORE_CONNECT_KEY").strip
    # Secret 可以直接貼 .p8 檔內容，也可以貼 Base64
    key_text = raw_key.include?("BEGIN PRIVATE KEY") ? raw_key : Base64.decode64(raw_key)
    # 重新整理成標準 PEM 格式（貼上時換行可能被吃掉或多出空白/\r）
    body = key_text.gsub(/-----(BEGIN|END) PRIVATE KEY-----/, "").gsub(/[^A-Za-z0-9+\/=]/, "")
    UI.user_error!("APP_STORE_CONNECT_KEY 內容不像 .p8 金鑰") if body.length < 100
    key_content = "-----BEGIN PRIVATE KEY-----\n#{body.scan(/.{1,64}/).join("\n")}\n-----END PRIVATE KEY-----\n"

    key_path = File.expand_path("../build/AuthKey_#{key_id}.p8", __dir__)
    FileUtils.mkdir_p(File.dirname(key_path))
    File.write(key_path, key_content)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      in_house: false
    )

    # 先確認金鑰真的能登入 App Store Connect，失敗時給清楚的錯誤訊息
    begin
      app = Spaceship::ConnectAPI::App.find("com.lin.energysaving")
      UI.success("API 金鑰驗證成功，找到 App：#{app&.name}")
    rescue => e
      UI.user_error!("API 金鑰無法登入 App Store Connect（請檢查 3 個 Secrets 是否正確）：#{e.message}")
    end

    # 小工具需要自己的 App ID，沒有的話先註冊（Xcode 自動註冊有時會失敗）
    widget_bundle_id = "com.lin.energysaving.widget"
    if Spaceship::ConnectAPI::BundleId.find(widget_bundle_id).nil?
      Spaceship::ConnectAPI::BundleId.create(
        name: "esapp Widget",
        platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
        identifier: widget_bundle_id
      )
      UI.success("已註冊小工具 App ID：#{widget_bundle_id}")
    end

    # build 號 = GitHub 執行次數 + 11，確保每次上傳都不重複
    if ENV["GITHUB_RUN_NUMBER"]
      increment_build_number(
        build_number: (ENV["GITHUB_RUN_NUMBER"].to_i + 11).to_s,
        xcodeproj: "CameraPPP.xcodeproj"
      )
    end

    update_code_signing_settings(
      use_automatic_signing: true,
      team_id: "98S428Y7GT",
      path: "CameraPPP.xcodeproj",
      targets: ["CameraPPP"]
    )

    auth_args = "-allowProvisioningUpdates -authenticationKeyPath #{key_path} " \
                "-authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id}"

    common = {
      project: "CameraPPP.xcodeproj",
      scheme: "CameraPPP",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "CameraPPP.ipa",
      # 打包時先不簽章（避免每台雲端機器都產生一張新的開發憑證把額度用完），
      # 匯出時再用 Apple 雲端管理的發佈憑證簽章
      xcargs: "#{auth_args} DEVELOPMENT_TEAM=98S428Y7GT CODE_SIGN_STYLE=Automatic CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO",
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: "98S428Y7GT",
        uploadSymbols: true,
        manageAppVersionAndBuildNumber: false
      }
    }

    # 1) 只打包 archive
    build_app(common.merge(clean: true, skip_package_ipa: true))
    archive_path = lane_context[SharedValues::XCODEBUILD_ARCHIVE]

    # 2) 第三方元件（Google 廣告等）被複製進 App 時，原本的簽名已失效、又沒被重簽，
    #    Apple 會以 Invalid Signature 退件 → 先拿掉舊簽名，讓匯出時統一用發佈憑證重簽
    Dir.glob(File.join(archive_path, "Products/Applications/*.app/Frameworks/*.framework")).each do |fw|
      sh("codesign", "--remove-signature", fw)
      UI.message("已移除舊簽名，匯出時重簽：#{File.basename(fw)}")
    end

    # 3) 匯出 ipa（重新簽名）
    build_app(common.merge(skip_build_archive: true, archive_path: archive_path))

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.lin.energysaving",
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  ensure
    File.delete(key_path) if key_path && File.exist?(key_path)
  end
end
