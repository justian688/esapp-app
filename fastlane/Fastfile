# Fastfile - es省電王（CameraPPP）TestFlight 自動部署
# 用 App Store Connect API 金鑰在雲端完成簽章，不需要 Mac 上的 Xcode 帳號或鑰匙圈。
require "base64"

default_platform(:ios)

platform :ios do
  desc "建置並上傳至 TestFlight（只限內部測試，不會送審）"
  lane :beta do
    key_id = ENV.fetch("APP_STORE_CONNECT_KEY_ID").strip
    issuer_id = ENV.fetch("APP_STORE_CONNECT_ISSUER_ID").strip
    raw_key = ENV.fetch("APP_STORE_CONNECT_KEY").strip
    # Secret 可以直接貼 .p8 檔內容，也可以貼 Base64
    key_text = raw_key.include?("BEGIN PRIVATE KEY") ? raw_key : Base64.decode64(raw_key)
    # 重新整理成標準 PEM 格式（貼上時換行可能被吃掉或多出空白/\r）
    body = key_text.gsub(/-----(BEGIN|END) PRIVATE KEY-----/, "").gsub(/[^A-Za-z0-9+\/=]/, "")
    UI.user_error!("APP_STORE_CONNECT_KEY 內容不像 .p8 金鑰") if body.length < 100
    key_content = "-----BEGIN PRIVATE KEY-----\n#{body.scan(/.{1,64}/).join("\n")}\n-----END PRIVATE KEY-----\n"

    key_path = File.expand_path("../build/AuthKey_#{key_id}.p8", __dir__)
    FileUtils.mkdir_p(File.dirname(key_path))
    File.write(key_path, key_content)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      in_house: false
    )

    # 先確認金鑰真的能登入 App Store Connect，失敗時給清楚的錯誤訊息
    begin
      app = Spaceship::ConnectAPI::App.find("com.lin.energysaving")
      UI.success("API 金鑰驗證成功，找到 App：#{app&.name}")
    rescue => e
      UI.user_error!("API 金鑰無法登入 App Store Connect（請檢查 3 個 Secrets 是否正確）：#{e.message}")
    end

    # 小工具需要自己的 App ID，沒有的話先註冊（Xcode 自動註冊有時會失敗）
    widget_bundle_id = "com.lin.energysaving.widget"
    if Spaceship::ConnectAPI::BundleId.find(widget_bundle_id).nil?
      Spaceship::ConnectAPI::BundleId.create(
        name: "esapp Widget",
        platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
        identifier: widget_bundle_id
      )
      UI.success("已註冊小工具 App ID：#{widget_bundle_id}")
    end

    # build 號 = GitHub 執行次數 + 11，確保每次上傳都不重複
    if ENV["GITHUB_RUN_NUMBER"]
      increment_build_number(
        build_number: (ENV["GITHUB_RUN_NUMBER"].to_i + 11).to_s,
        xcodeproj: "CameraPPP.xcodeproj"
      )
    end

    update_code_signing_settings(
      use_automatic_signing: true,
      team_id: "98S428Y7GT",
      path: "CameraPPP.xcodeproj",
      targets: ["CameraPPP"]
    )

    auth_args = "-allowProvisioningUpdates -authenticationKeyPath #{key_path} " \
                "-authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id}"

    build_app(
      project: "CameraPPP.xcodeproj",
      scheme: "CameraPPP",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "CameraPPP.ipa",
      clean: true,
      # 打包時先不簽章（避免每台雲端機器都產生一張新的開發憑證把額度用完），
      # 匯出時再用 Apple 雲端管理的發佈憑證簽章
      xcargs: "#{auth_args} DEVELOPMENT_TEAM=98S428Y7GT CODE_SIGN_STYLE=Automatic CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO",
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: "98S428Y7GT",
        uploadSymbols: true,
        manageAppVersionAndBuildNumber: false
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.lin.energysaving",
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  ensure
    File.delete(key_path) if key_path && File.exist?(key_path)
  end
end
